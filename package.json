{
  "name": "@vibers/admin-kit",
  "version": "1.0.1",
  "description": "Vibers 통합 어드민 연동 계약 + 서버 핸들러",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" },
    "./envelope": { "types": "./dist/envelope.d.ts", "default": "./dist/envelope.js" },
    "./resources": { "types": "./dist/resources.d.ts", "default": "./dist/resources.js" },
    "./capabilities": { "types": "./dist/capabilities.d.ts", "default": "./dist/capabilities.js" },
    "./mutations": { "types": "./dist/mutations.d.ts", "default": "./dist/mutations.js" },
    "./verify": { "types": "./dist/verify.d.ts", "default": "./dist/verify.js" },
    "./ui": { "types": "./dist/ui/index.d.ts", "default": "./dist/ui/index.js" },
    "./ui.css": "./src/ui/admin-shell.css",
    "./handler": { "types": "./dist/handler.d.ts", "default": "./dist/handler.js" },
    "./firestore-adapter": { "types": "./dist/firestore-adapter.d.ts", "default": "./dist/firestore-adapter.js" }
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md"],
  "repository": { "type": "git", "url": "https://github.com/vibers-leo/vibers-admin-kit.git" }
}
